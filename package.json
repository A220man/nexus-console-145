{
  "name": "nexus-console-145",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "uvicorn backend.main:app --reload --port 8000",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "test": "python -m pytest tests/ -v",
    "lint": "ruff check backend/ scripts/ && npm run lint --workspace=frontend",
    "install:skill": "node scripts/install.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
